generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SchoolStatus {
  PENDING_EMAIL_VERIFICATION
  PENDING_ACTIVATION // SuperAdmin must approve first
  PAYMENT_REQUIRED   // Approved by SuperAdmin, but needs active subscription
  ACTIVE             // Fully operational
  SUSPENDED
  EXPIRED            // Subscription ran out
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

// 

//
// NEW RBAC MODELS
//
model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id        String           @id @default(cuid())
  name      String           @unique
  roles     RolePermission[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([roleId, permissionId])
}

//
// EXISTING MODELS
//

model School {
  id                      String                  @id @default(uuid())
  name                    String                  @unique
  contact_email           String                  @unique
  website                 String?
  status                  SchoolStatus            @default(PENDING_EMAIL_VERIFICATION)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  users                   User[]
  subscriptions           Subscription[]
  emailVerificationTokens EmailVerificationToken[]

  bulkUploadLogs BulkUploadLog[] @relation("SchoolBulkUploads")

  activationData Json?
}

model Subscription {
  id                   String   @id @default(uuid())
  schoolId             String
  stripeSubscriptionId String   @unique
  planTier             String   // e.g., "BASIC", "PREMIUM"
  status               String   // e.g., "active", "canceled", "past_due"
  currentPeriodEnd     DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  school               School   @relation(fields: [schoolId], references: [id])
}

model User {
  id           String     @id @default(uuid())
  schoolId     String? 
  roleId       String?
  role         Role?      @relation(fields: [roleId], references: [id])
  school       School?    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  adminOtps    AdminOtp[]
  firstName    String
  lastName     String
  email        String     @unique
  passwordHash String
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  biometricLogs     BiometricLog[]
  moodLogs          MoodLog[]
  alertsAsStudent   Alert[]                     @relation("AlertsAsStudent")
  alertsAsCounselor Alert[]                     @relation("AlertsAsCounselor")
  parentOf          ParentStudentRelationship[] @relation("ParentToStudent")
  studentOf         ParentStudentRelationship[] @relation("StudentToParent")
  consent           Consent?

  bulkUploadLogs BulkUploadLog[] @relation("AdminBulkUploads")

  appointmentsAsStudent   Appointment[] @relation("StudentAppointments")
  appointmentsAsCounselor Appointment[] @relation("CounselorAppointments")

  refreshTokens RefreshToken[]
  aiAnalyses    AIAnalysis[]
  auditLogs     AuditLog[]

  @@index([schoolId])
}

model BiometricLog {
  id               String   @id @default(uuid())
  userId           String
  timestamp        DateTime @default(now())
  heartRate        Float
  skinTemp         Float
  gsr              Float
  movement         Float
  stressLevelScore Float
  createdAt        DateTime @default(now())
