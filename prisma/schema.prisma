generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SchoolStatus {
  PENDING_EMAIL_VERIFICATION
  PENDING_ACTIVATION
  ACTIVE
  SUSPENDED
}

enum Role {
  ADMIN
  COUNSELOR
  TEACHER
  STUDENT
}

model School {
  id                      String                   @id @default(uuid())
  name                    String                   @unique
  contact_email           String                   @unique
  website                 String?
  status                  SchoolStatus             @default(PENDING_EMAIL_VERIFICATION)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  users                   User[]
  subscriptions           Subscription[]
  emailVerificationTokens EmailVerificationToken[]

  // form data after activation request
  activationData Json?
}

model Subscription {
  id                   String   @id @default(uuid())
  schoolId             String
  stripeSubscriptionId String
  planTier             String
  status               String
  currentPeriodEnd     DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  school               School   @relation(fields: [schoolId], references: [id])
}

model User {
  id           String     @id @default(uuid())
  schoolId     String
  role         Role // ✅ Enum
  adminOtps    AdminOtp[]
  firstName    String
  lastName     String
  email        String     @unique
  passwordHash String
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  school       School     @relation(fields: [schoolId], references: [id])

  biometricLogs     BiometricLog[]
  moodLogs          MoodLog[]
  alertsAsStudent   Alert[]                     @relation("AlertsAsStudent")
  alertsAsCounselor Alert[]                     @relation("AlertsAsCounselor")
  parentOf          ParentStudentRelationship[] @relation("ParentToStudent")
  studentOf         ParentStudentRelationship[] @relation("StudentToParent")
  consent           Consent?

  // ✅ Only one admin per school
  @@unique([schoolId, role], name: "OneAdminPerSchool")
}

model BiometricLog {
  id               String   @id @default(uuid())
  userId           String
  timestamp        DateTime @default(now())
  heartRate        Float
  skinTemp         Float
  gsr              Float
  movement         Float
  stressLevelScore Float
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id])
}

model MoodLog {
  id        String   @id @default(uuid())
  userId    String
  timestamp DateTime @default(now())
  moodEmoji String
  notes     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Alert {
  id          String   @id @default(uuid())
  studentId   String
  counselorId String
  timestamp   DateTime @default(now())
  alertType   String
  message     String
  isResolved  Boolean  @default(false)
  notes       String?
  createdAt   DateTime @default(now())
  student     User     @relation("AlertsAsStudent", fields: [studentId], references: [id])
  counselor   User     @relation("AlertsAsCounselor", fields: [counselorId], references: [id])
}

model ParentStudentRelationship {
  parentId  String
  studentId String
  parent    User   @relation("ParentToStudent", fields: [parentId], references: [id])
  student   User   @relation("StudentToParent", fields: [studentId], references: [id])

  @@id([parentId, studentId])
}

model Consent {
  id                   String   @id @default(uuid())
  userId               String   @unique
  consentGiven         Boolean  @default(false)
  anonymizeData        Boolean  @default(false)
  parentalConsentGiven Boolean  @default(false)
  createdAt            DateTime @default(now())
  user                 User     @relation(fields: [userId], references: [id])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model AdminOtp {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}
