  activationData Json?
}
model Subscription {
  id                  String     @id @default(uuid())
  schoolId            String
  stripeSubscriptionId String
  planTier            String
  status              String
  currentPeriodEnd    DateTime
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  school              School     @relation(fields: [schoolId], references: [id])
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String
  users User[]
}

model User {
  id                  String      @id @default(uuid())
  schoolId            String
  roleId              Int
  firstName           String
  lastName            String
  email               String      @unique
  passwordHash        String
  isActive            Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  school              School      @relation(fields: [schoolId], references: [id])
  role                Role        @relation(fields: [roleId], references: [id])
  biometricLogs       BiometricLog[]
  moodLogs            MoodLog[]
  alertsAsStudent     Alert[]     @relation("AlertsAsStudent")
  alertsAsCounselor   Alert[]     @relation("AlertsAsCounselor")
  parentOf            ParentStudentRelationship[] @relation("ParentToStudent")
  studentOf           ParentStudentRelationship[] @relation("StudentToParent")
  consent             Consent?
}


model BiometricLog {
  id                String    @id @default(uuid())
