// Direct messages between a counselor and one of their assigned students.
// A "conversation" isn't its own entity — it's just every Message row
// between two particular users, since each relationship is exactly one
// counselor and one student (no group chat).
model Message {
  id          String   @id @default(uuid())
  senderId    String
  recipientId String
  content     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  sender      User     @relation("MessagesSent",     fields: [senderId],    references: [id], onDelete: Cascade)
  recipient   User     @relation("MessagesReceived",  fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, recipientId])
  @@index([recipientId, isRead])
}
