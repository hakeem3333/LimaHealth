model FitbitCredential {
  id           String   @id @default(uuid())
  userId       String   @unique
  fitbitUserId String   @unique // Google Health API healthUserId
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  scope        String?
  tokenType    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])
}
