model Subscription {
  id                  String     @id @default(uuid())
  orgId            String
  stripeSubscriptionId String     @unique
  planTier            String
  status              String
  currentPeriodEnd    DateTime
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  org               Organisation     @relation(fields: [orgId], references: [id])
}