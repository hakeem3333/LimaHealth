model Subscription {
  id                  String     @id @default(uuid())
  schoolId            String
  stripeSubscriptionId String
  planTier            String
  status              String
  currentPeriodEnd    DateTime
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  school              School     @relation(fields: [schoolId], references: [id])
}