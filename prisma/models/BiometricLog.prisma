model BiometricLog {
  id                String    @id @default(uuid())
  userId            String
  timestamp         DateTime  @default(now())
  heartRate         Float
  hrv               Float?    // nightly HRV (RMSSD, ms); null = not measured
  skinTemp          Float     // 0 = not measured
  gsr               Float     // 0 = not measured
  movement          Float
  stressLevelScore  Float
  steps             Float     @default(0)
  calories          Float     @default(0)
  sleepHours        Float     @default(0)
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id])
}