model BiometricLog {
  id                String    @id @default(uuid())
  userId            String
  timestamp         DateTime  @default(now())
  heartRate         Float
  skinTemp          Float
  gsr               Float
  movement          Float
  stressLevelScore  Float
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id])
}