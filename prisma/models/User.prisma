model User {
  id                  String      @id @default(uuid())
  schoolId            String
  roleId              Int
  firstName           String
  lastName            String
  email               String      @unique
  passwordHash        String
  isActive            Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  school              School      @relation(fields: [schoolId], references: [id])
  role                Role        @relation(fields: [roleId], references: [id])
  biometricLogs       BiometricLog[]
  moodLogs            MoodLog[]
  alertsAsStudent     Alert[]     @relation("AlertsAsStudent")
  alertsAsCounselor   Alert[]     @relation("AlertsAsCounselor")
  parentOf            ParentStudentRelationship[] @relation("ParentToStudent")
  studentOf           ParentStudentRelationship[] @relation("StudentToParent")
  consent             Consent?
}
