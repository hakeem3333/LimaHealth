model User {
  id                  String      @id @default(uuid())
  orgId            String?
  roleId              String?
  firstName           String
  lastName            String
  email               String      @unique
  passwordHash        String
  isActive            Boolean     @default(true)
  isAvailable         Boolean     @default(true)  // for counselors: accepting new bookings
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  org               Organisation? @relation(fields: [orgId], references: [id])
  role                Role?       @relation(fields: [roleId], references: [id])
  biometricLogs       BiometricLog[]
  moodLogs            MoodLog[]
  alertsAsStudent     Alert[]              @relation("AlertsAsStudent")
  alertsAsCounselor   Alert[]              @relation("AlertsAsCounselor")
  appointmentsAsStudent   Appointment[]    @relation("AppointmentsAsStudent")
  appointmentsAsCounselor Appointment[]    @relation("AppointmentsAsCounselor")
  aiAnalyses          AIAnalysis[]
  fitbitCredential    FitbitCredential?
  passwordResetTokens PasswordResetToken[]
  parentOf            ParentStudentRelationship[] @relation("ParentToStudent")
  studentOf           ParentStudentRelationship[] @relation("StudentToParent")
  consent             Consent?
  adminOtp            AdminOtp?
}
