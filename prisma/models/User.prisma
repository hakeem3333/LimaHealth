model User {
  id                  String      @id @default(uuid())
  orgId            String?
  roleId              String?
  firstName           String
  lastName            String
  dateOfBirth         DateTime?   // used to determine if a student requires parental consent
  email               String      @unique
  passwordHash        String?     // null for passwordless accounts (e.g. PARENT — see ParentLoginOtp)
  isActive            Boolean     @default(true)
  isAvailable         Boolean     @default(true)  // for counselors: accepting new bookings
  mustChangePassword  Boolean     @default(false) // set on temp-password creation (bulk upload); cleared on first password change
  pushToken           String?     // Expo push token for this device; overwritten on each login/registration
  profileImage        String?     // relative URL path (e.g. /uploads/profile-images/xyz.jpg) to the user's avatar
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  org               Organisation? @relation(fields: [orgId], references: [id])
  role                Role?       @relation(fields: [roleId], references: [id])
  biometricLogs       BiometricLog[]
  moodLogs            MoodLog[]
  alertsAsStudent     Alert[]              @relation("AlertsAsStudent")
  alertsAsCounselor   Alert[]              @relation("AlertsAsCounselor")
  appointmentsAsStudent   Appointment[]    @relation("AppointmentsAsStudent")
  appointmentsAsCounselor Appointment[]    @relation("AppointmentsAsCounselor")
  aiAnalyses          AIAnalysis[]
  fitbitCredential    FitbitCredential?
  passwordResetTokens PasswordResetToken[]
  parentOf            ParentStudentRelationship[] @relation("ParentToStudent")
  studentOf           ParentStudentRelationship[] @relation("StudentToParent")
  parentConsentTokensAsStudent ParentConsentToken[] @relation("ParentConsentStudent")
  parentConsentTokensAsParent  ParentConsentToken[] @relation("ParentConsentParent")
  // Counselor caseload assignment (a student's assigned counselor, if any)
  assignedCounselorId String?
  assignedCounselor   User?       @relation("CounselorAssignments", fields: [assignedCounselorId], references: [id])
  assignedStudents    User[]      @relation("CounselorAssignments")
  counselorNotesAuthored     CounselorNote[] @relation("CounselorNotesAuthored")
  counselorNotesAboutMe      CounselorNote[] @relation("CounselorNotesAboutStudent")
  counselorChangeRequestsAsStudent   CounselorChangeRequest[] @relation("CounselorChangeRequestsAsStudent")
  counselorChangeRequestsAsCurrent  CounselorChangeRequest[] @relation("CounselorChangeRequestsAsCurrentCounselor")
  counselorChangeRequestsAsNew      CounselorChangeRequest[] @relation("CounselorChangeRequestsAsNewCounselor")
  counselorChangeRequestsResolved  CounselorChangeRequest[] @relation("CounselorChangeRequestsResolvedBy")
  weeklyAvailability  CounselorAvailability[] @relation("CounselorAvailability")
  timeOff             CounselorTimeOff[]      @relation("CounselorTimeOff")
  messagesSent        Message[] @relation("MessagesSent")
  messagesReceived    Message[] @relation("MessagesReceived")
  consent             Consent?
  adminOtp            AdminOtp?
  parentLoginOtp      ParentLoginOtp?
  refreshTokens       RefreshToken[]
  auditLogs           AuditLog[]
  bulkUploadLogs      BulkUploadLog[]

  @@index([assignedCounselorId])
}
