model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actorRole  String
  action     String
  targetType String?
  targetId   String?
  ipAddress  String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User     @relation(fields: [actorId], references: [id])

  @@index([action])
  @@index([actorRole])
  @@index([createdAt])
}
