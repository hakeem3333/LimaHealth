# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/limahealth"

# JWT — use a long random string in production (e.g. openssl rand -hex 64)
JWT_SECRET=change-me-to-a-long-random-secret

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3001,http://localhost:8081

# Fitbit data via the Google Health API (Google OAuth 2.0 "Web application" client
# from Google Cloud Console; the redirect URI must be registered on that client)
GOOGLE_HEALTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_HEALTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_HEALTH_REDIRECT_URI=https://your-domain.com/api/v1/fitbit/callback
# Optional overrides (defaults shown) — point these at a mock server for testing
GOOGLE_HEALTH_API_BASE_URL=https://health.googleapis.com/v4
GOOGLE_HEALTH_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_HEALTH_TOKEN_URL=https://oauth2.googleapis.com/token
# How often the backend pulls fresh data for every linked user (minutes)
FITBIT_SYNC_INTERVAL_MINUTES=30

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM="no-reply@yourdomain.com"

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_BASIC_PRICE=price_...
STRIPE_STANDARD_PRICE=price_...

# App URLs
FRONTEND_URL=http://localhost:19006
FRONTEND_BASE_URL=http://localhost:3001
APP_BASE_URL=http://localhost:3000

# Node environment
NODE_ENV=development
PORT=3000

# Super Admin seed values
SUPER_ADMIN_EMAIL=superadmin@yourdomain.com
SUPER_ADMIN_PASSWORD=ChangeMe123!
SUPERADMIN_FIRSTNAME=Super
SUPERADMIN_LASTNAME=Admin

# LimaModel ML service URL
ML_SERVICE_URL=http://localhost:8000

# Shared password for the local demo accounts (prisma/seed-demo-accounts.js)
DEMO_USER_PASSWORD=
