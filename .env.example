# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/limahealth"

# JWT — use a long random string in production (e.g. openssl rand -hex 64)
JWT_SECRET=change-me-to-a-long-random-secret

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3001,http://localhost:8081

# Fitbit OAuth
FITBIT_CLIENT_ID=your-fitbit-client-id
FITBIT_CLIENT_SECRET=your-fitbit-client-secret
FITBIT_REDIRECT_URI=https://your-domain.com/api/v1/fitbit/callback

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM="no-reply@yourdomain.com"

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_BASIC_PRICE=price_...
STRIPE_STANDARD_PRICE=price_...

# App URLs
FRONTEND_URL=http://localhost:19006
FRONTEND_BASE_URL=http://localhost:3001
APP_BASE_URL=http://localhost:3000

# Node environment
NODE_ENV=development
PORT=3000

# Super Admin seed values
SUPER_ADMIN_EMAIL=superadmin@yourdomain.com
SUPER_ADMIN_PASSWORD=ChangeMe123!
SUPERADMIN_FIRSTNAME=Super
SUPERADMIN_LASTNAME=Admin

# LimaModel ML service URL
ML_SERVICE_URL=http://localhost:8000
